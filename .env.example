# ==============================================================================
# REVIVE — Autonomous Revenue Recovery Agent
# Configuration Template (.env.example)
#
# Copy this file to .env and configure for local development / testing.
# NEVER COMMIT YOUR REAL .env FILE OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DATABASE_URL=sqlite:///./data/revive.db

# AI / LLM Reasoning Engine (Configurable Provider)
# Supported providers: "gemini", "openai", "heuristic_fallback"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Deterministic Safety & Financial Policy Thresholds
POLICY_MAX_RETRY_COUNT=3
POLICY_COOLDOWN_HOURS=24
POLICY_MAX_DISCOUNT_PERCENT=15
POLICY_MAX_COMMUNICATION_ATTEMPTS=2
POLICY_ENABLE_SAFETY_GATE=true

# Razorpay Test Mode Credentials (Optional / Phase 8+)
# Use ONLY test mode keys starting with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Simulation & Evaluation Config
SIMULATION_RANDOM_SEED=42
EVALUATION_SPLIT_RATIO=0.8
