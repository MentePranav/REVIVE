# ==============================================================================
# REVIVE - Autonomous Revenue Recovery System
# Environment Configuration Template (.env.example)
#
# REVIVE runs 100% locally with zero external network or API dependencies.
# No API keys, passwords, or cloud credentials are required.
# ==============================================================================

# Server & Network Binding (Host & Port)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Public Security & CORS (Optional: comma-separated origins, default: "*")
APP_ALLOWED_ORIGINS=*
APP_RATE_LIMIT_ENABLED=true
APP_SECURITY_HEADERS_ENABLED=true

# Simulation & Demo Defaults
DEFAULT_DEMO_SEED=42
DEFAULT_DEMO_SIZE=100
DEFAULT_SCENARIO=balanced

# Mode & Safety Invariants (Safety policies cannot be disabled via configuration)
MODE=synthetic_simulation_benchmark
ALLOW_POLICY_BYPASS=false
